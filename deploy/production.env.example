# Production environment (Deployment-2A) — TEMPLATE ONLY, placeholders only.
# Copy to the server as /etc/industry-intelligence/production.env (owner root, mode 600) and fill
# in real values there. Never commit the real file (deploy/*.env is gitignored).
# Read by deploy/bin/ii-compose: compose interpolation (--env-file) and the backend container
# (env_file). Plain KEY=value lines; no quotes, no spaces around '='.

# Public hostname served by Caddy (no scheme, no path), e.g. intel.your-domain.
APP_DOMAIN=your-domain.invalid

# Must both be exactly https://<APP_DOMAIN>. The frontend is same-origin with the API behind
# Caddy; NEXT_PUBLIC_API_BASE_URL is baked into the frontend image at build time (rebuild after a
# change). CORS_ORIGINS is the one exact origin (never '*'; production rejects it).
NEXT_PUBLIC_API_BASE_URL=https://your-domain.invalid
CORS_ORIGINS=https://your-domain.invalid

# PostgreSQL container (private network, no published port). Use a long random password made of
# letters and digits only, so it can be written into DATABASE_URL without URL escaping.
POSTGRES_DB=industry_intelligence
POSTGRES_USER=industry
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://industry:change-me@postgres:5432/industry_intelligence

# Forced to production by the compose file as well (hides /docs, /redoc, /openapi.json).
ENVIRONMENT=production
LOG_LEVEL=INFO

# Optional. The daily update does not need them: Wikipedia rankings are manual-only and SEC
# profiles are a manual command. Placeholders count as unset.
# SOURCE_CONTACT=your-email@example.com
# SEC_CONTACT=your-email@example.com

# Optional AI (scheduled AI is disabled; the daily job always runs --skip-ai). Needs an image built
# with EXTRAS=[ai]. Leave unset for deterministic production operation.
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=

# Optional image tag for the locally built images (default latest).
# IMAGE_TAG=latest
