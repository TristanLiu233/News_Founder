# Base URL for the FastAPI service. Copy this file to .env.local for local development; the local
# backend runs on 127.0.0.1:8040 (ops/dev/start-local.sh keeps this line in .env.local).
# NEXT_PUBLIC_* values are inlined into the browser bundle by `npm run build`, so a production
# build must be made with the public API origin set (changing it later requires a rebuild).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8040
