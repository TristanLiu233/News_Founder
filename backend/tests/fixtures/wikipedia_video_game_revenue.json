td><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/United_States\" title=\"United States\"><img alt=\"United States\" class=\"mw-file-element\" height=\"12\" width=\"23\"/></a></span></span> <a href=\"/wiki/San_Mateo,_California\" title=\"San Mateo, California\">San Mateo, California</a>\n</td>\n<td data-sort-value=\"03600000000\"><span typeof=\"mw:File\"><span title=\"Increase\"><img alt=\"Increase\" class=\"mw-file-element\" height=\"11\" width=\"11\"/></span></span> $4.9 billion\n</td>\n<td><sup class=\"reference\" id=\"cite_ref-11\"><a href=\"#cite_note-11\"><span class=\"cite-bracket\">[</span>11<span class=\"cite-bracket\">]</span></a></sup>\n</td></tr>\n<tr>\n<td>11\n</td>\n<td><a href=\"/wiki/MiHoYo\" title=\"MiHoYo\">miHoYo</a>\n</td>\n<td><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/China\" title=\"China\"><img alt=\"China\" class=\"mw-file-element\" height=\"15\" width=\"23\"/></a></span></span> <a href=\"/wiki/Shanghai\" title=\"Shanghai\">Shanghai</a>, China\n</td>\n<td data-sort-value=\"04700000000\"><span typeof=\"mw:File\"><span title=\"Increase\"><img alt=\"Increase\" class=\"mw-file-element\" height=\"11\" width=\"11\"/></span></span> $4.2 billion (estimate)\n</td>\n<td><sup class=\"reference\" id=\"cite_ref-12\"><a href=\"#cite_note-12\"><span class=\"cite-bracket\">[</span>12<span class=\"cite-bracket\">]</span></a></sup>\n</td></tr>\n<tr>\n<td>12\n</td>\n<td><a href=\"/wiki/Bandai_Namco_Entertainment\" title=\"Bandai Namco Entertainment\">Bandai Namco Entertainment</a>\n</td>\n<td><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Japan\" title=\"Japan\"><img alt=\"Japan\" class=\"mw-file-element\" height=\"15\" width=\"23\"/></a></span></span> <a href=\"/wiki/Minato,_Tokyo\" title=\"Minato, Tokyo\">Minato, Tokyo</a>, Japan\n</td>\n<td data-sort-value=\"02100000000\"><span typeof=\"mw:File\"><span title=\"Increase\"