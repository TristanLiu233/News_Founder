# Application settings
APP_NAME=Industry Intelligence & Ranking Platform
# ENVIRONMENT=production hides /docs, /redoc, and /openapi.json and rejects a '*' CORS origin.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated browser origins of the frontend (e.g. https://your-domain in production).
CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL (docker compose, bound to 127.0.0.1). Replace the placeholder password before
# using it outside local development; production uses its own strong password and DATABASE_URL.
POSTGRES_DB=industry_intelligence
POSTGRES_USER=industry
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://industry:change-me@localhost:5432/industry_intelligence

# Phase 1 retrieval
SOURCE_FETCH_LIMIT=30
SOURCE_HTTP_TIMEOUT=20
# Contact of the deployment maintainer, sent only to Wikimedia (User-Agent policy) for the
# Wikipedia company rankings. Replace with your own; example.com placeholders count as unset.
SOURCE_CONTACT=your-email@example.com
# Separate contact of the deployment maintainer, declared only to SEC EDGAR (sec.gov and
# data.sec.gov) as SEC's fair-access policy requires, for company profiles. Every clone or
# deployment must replace this placeholder with its own maintainer email; placeholders count as
# unset and SEC profile ingestion then refuses to run.
SEC_CONTACT=your-email@example.com

# Phase 3 search (independent of Trending RRF)
SEARCH_RECENT_TITLES=8
SEARCH_DOCUMENT_CHARS=12000
SEARCH_RRF_K=60
SEARCH_LEXICAL_WEIGHT=1
SEARCH_SEMANTIC_WEIGHT=1
SEARCH_TRIGRAM_THRESHOLD=0.4
SEARCH_SEMANTIC_CANDIDATES=200
SEARCH_SEMANTIC_MAX_DISTANCE=0.45

# Optional compatible embedding endpoint (full /embeddings URL).
# Select and independently verify a Chinese + English multilingual model.
# EMBEDDING_URL=http://localhost:8080/v1/embeddings
# EMBEDDING_MODEL=your-multilingual-model
# EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT=8

# Phase 7 AI enrichment (optional; CLI batch commands only — page requests never call a provider).
# Leave blank to run without AI: pages then show "AI insight not available".
# AI_PROVIDER names a registered adapter (currently: anthropic; install with
# pip install -e "./backend[ai]"). Use your own key, keep it only in this gitignored .env,
# and never commit it. Placeholders such as your-api-key count as unset.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=your-api-key
# AI_BASE_URL=
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4000
AI_REQUEST_INTERVAL=1.0
